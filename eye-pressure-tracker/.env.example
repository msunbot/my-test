# Anthropic API key, used to read pressure values off the photo.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gmail address that will SEND the emails (needs an App Password, not your regular password).
# Create one at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Address that will RECEIVE the spreadsheet emails.
RECIPIENT_EMAIL=sunmaggie.wl@gmail.com

# Any random string, used to sign Flask's session cookie.
FLASK_SECRET_KEY=change-me

# Where to store the SQLite database file (leave default for local runs).
# On Render this is set to /var/data/readings.db to use the persistent disk.
DB_PATH=data/readings.db
